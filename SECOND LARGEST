#include <stdio.h>

int main() {
    int arr[] = {12, 35, 1, 10, 34, 1};
    int size = 6; 
    int max1 = arr[0];
    int max2 = arr[1];
    if (max2 > max1) {
        int temp = max1;
        max1 = max2;
        max2 = temp;
    }
    for (int i = 2; i < size; i++) {
        if (arr[i] > max1) {
            max2 = max1;  
            max1 = arr[i]; 
        } 
        else if (arr[i] > max2 && arr[i] != max1) {
            max2 = arr[i]; 
        }
    }

    printf("The second largest number is: %d\n", max2);

    return 0;
}
